PORT=8000
MONGO_URI=mongodb://localhost:27017/loop?replicaSet=rs0
REDIS_URL=redis://localhost:6380
LOG_LEVEL=info
TENANT_STOREFRONT_KEYS=dev-storefront-key:rest_demo
MARKETPLACE_WEBHOOK_SECRETS=rest_demo:dev-marketplace-secret
TENANT_ADMIN_KEYS=dev-admin-key:rest_demo

# Slice 3: free-tier key from https://aistudio.google.com/apikey — required
# for the retention agent's real decisions and the eval script (npm run eval).
# Without it, decisions still work end-to-end but always land as a logged
# 'failed' agent_decisions row (Locked Contract #5's retry-then-skip path).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
RETENTION_DAILY_SEND_CAP=50
RETENTION_SCHEDULE_INTERVAL_MS=86400000

# Slice 4: optional. PageSpeed Insights works keyless but its anonymous
# quota is low (a handful of requests/minute) — a free key from
# https://console.cloud.google.com (enable "PageSpeed Insights API")
# raises it substantially.
PAGESPEED_API_KEY=
